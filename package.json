{
  "name": "isfree.se",
  "version": "2.0.0",
  "description": "isfree.se",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "deploy-staging": "wrangler deploy --env staging --minify",
    "check": "npx biome check",
    "check:fix": "npx biome check --write",
    "test:react": "vitest -c vitest.react.config.ts --run",
    "test:worker": "vitest -c vitest.worker.config.ts --run",
    "test": "npm run test:react && npm run test:worker",
    "typecheck": "npx tsc --build --noEmit"
  },
  "dependencies": {
    "hono": "^4.12.34",
    "idna-uts46-hx": "^6.1.7",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^5.20260713.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/luxon": "^3.7.2",
    "@types/punycode": "^2.1.4",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
